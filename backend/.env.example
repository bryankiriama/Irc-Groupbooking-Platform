APP_NAME=Group Ticket Booking API
ENV=development
HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/groupbooking

JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxx
MOLLIE_WEBHOOK_BASE_URL=http://localhost:8000

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=false

CORS_ORIGINS=http://localhost:5173
